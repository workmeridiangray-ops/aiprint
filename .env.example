# Copy to .env. Never commit real secrets.
DATABASE_URL=postgres://artwork:artwork_dev@localhost:5432/artwork_dev
TEST_DATABASE_URL=postgres://artwork:artwork_dev@localhost:5432/artwork_test
APP_ENV=development            # development | staging | production
STORAGE_DRIVER=local           # local (dev only) | s3 (see S3_* below)
STORAGE_LOCAL_DIR=./.data/files
SESSION_TTL_HOURS=12
# Payment provider. Unset = nobody can pay, top up, be refunded to a bank or be settled (fails closed).
#   razorpay : needs the three RAZORPAY_ values below. Orders, signed webhooks, order look-up and refunds. NOT yet run against a live account. No payouts.
#   sandbox  : simulated provider for development and tests ONLY; refused when APP_ENV is staging or production.
# Webhook URL to register with the provider: {APP_URL}/api/payments/webhook/razorpay  (events: payment.captured, order.paid, payment.failed)
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Settlement transfers. Leave unset for automated transfers through a provider that supports them.
# Set to "manual" ONLY after the client has elected the manual-settlement fallback in writing: finance then pays by bank and records each reference.
SETTLEMENT_MODE=

# Two-step sign-in. MFA_ENC_KEY: 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Required in staging/production.
MFA_ENC_KEY=
MFA_REQUIRED_ROLES=platform_owner,platform_support,platform_finance
AUTH_HASH_SALT=                # random string; hashes emails/sources in the lockout table

# Email. EMAIL_DRIVER=smtp (production) or file (development only). Unset = nothing is sent.
EMAIL_DRIVER=
EMAIL_FROM=                    # e.g. noreply@your-domain
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
APP_URL=http://localhost:3000   # required in production; used in email links

# Object storage. local = development only (refused in staging/production). s3 = any S3-compatible bucket (AWS S3, R2, MinIO, Wasabi...).
# Check with: npm run check:storage   (local S3-compatible server for development: npm run dev:s3)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=                   # leave empty for AWS; https required in production
# Image enhancement needs python3 with OpenCV (opencv-contrib-python-headless). The Docker image installs it. Override the interpreter if needed:
# ENHANCE_PYTHON=python3
# Image enhancement needs python3 with OpenCV (opencv-contrib-python-headless). The Docker image installs it. Override the interpreter if needed:
# ENHANCE_PYTHON=python3
S3_FORCE_PATH_STYLE=false      # true for MinIO / local servers
S3_ACCESS_KEY_ID=              # empty = use the platform's own credentials (instance role)
S3_SECRET_ACCESS_KEY=
S3_SSE=                        # AES256 or aws:kms (optional)
# Job wake-ups. Optional: without it workers check the database every 5 seconds. Jobs and money live in Postgres either way.
REDIS_URL=                     # e.g. redis://localhost:6379 or rediss://... for TLS

# Download links are signed and last 5 minutes. Required in staging/production (e.g. `openssl rand -base64 32`).
DOWNLOAD_LINK_SECRET=
# A queued job that no worker picked up within this many minutes is cancelled and its hold released (proposed default, confirm with client).
HOLD_EXPIRY_MINUTES=30

# Hosted Postgres (Supabase etc.): require = TLS with certificate checking. DATABASE_SSL_CA = provider CA certificate (PEM) if Node does not trust it.
DATABASE_SSL=
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10
CLOSURE_NOTICE_DAYS=14
CLOSED_STORE_PURGE_DAYS=7

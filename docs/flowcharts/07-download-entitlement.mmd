%% 7. Paid preview, download entitlement, changed versions, free redownload
flowchart TD
  A["Output ready for a project version"] --> B["Preview in the editor"]
  B --> W["Watermarked preview: NOT BUILT<br/>preview currently shown without watermark"]:::nb
  A --> C["Charge settled when the job finishes"]
  C --> D["Entitlement: this output file, this customer"]
  D --> E["Download from Your files"]
  E --> F["Download again while the file is kept: free, any number of times"]
  G["Customer changes the project"] --> H["New revision, new quote"]
  H --> I["New output is a new charge, old output stays as is"]
  D --> R{"After 90 days or deleted"}
  R -->|"expired"| X["File purged, record and ledger kept<br/>must run a new job"]:::fail
  R -->|"customer deleted it"| X
  R -->|"retention hold"| K["Kept until the hold is released"]
  classDef built fill:#e3f1f1,stroke:#0f5f63,color:#14202b
classDef nb fill:#f1f1f1,stroke:#8a8a8a,stroke-dasharray:5 3,color:#555
classDef fail fill:#fdeaea,stroke:#b3261e,color:#14202b
  class A,B,C,D,E,F,G,H,I,K built
